# Prefer native Groq (ChatGroq) — avoids broken tool calls via OpenAI base URL
GROQ_API_KEY=gsk_...
MODEL=llama-3.3-70b-versatile

# Or OpenAI / OpenAI-compatible instead of Groq:
# OPENAI_API_KEY=sk-...
# MODEL=openai:gpt-4o-mini

# Langfuse — set LANGFUSE_ENABLED=true to emit middleware spans
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Self-hosted (helm + port-forward):
LANGFUSE_HOST=http://localhost:3000
# Cloud alternative:
# LANGFUSE_HOST=https://cloud.langfuse.com

# Optional live web search (otherwise research tools use fixtures)
# TAVILY_API_KEY=tvly-...
# EXA_API_KEY=...

# Conversation thread id (checkpoint)
THREAD_ID=deepagent-poc-demo
